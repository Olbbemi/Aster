#!/usr/bin/env python3
"""Prepare Aster's shared todo directory after a branch checkout."""

from pathlib import Path
import sys


def main():
    if len(sys.argv) != 4 or sys.argv[3] not in ("0", "1"):
        print("Usage: post-checkout OLD_HEAD NEW_HEAD BRANCH_FLAG (0 or 1)",
              file=sys.stderr)
        return 1
    if sys.argv[3] == "0":
        return 0
    try:
        # mkdir preserves directory links and rejects files and dangling links.
        # Use the project identity, not the clone or worktree directory name.
        todo = Path.home() / ".local/share/aster/todo"
        todo.mkdir(parents=True, exist_ok=True)
    except (OSError, RuntimeError) as error:
        print(f"Aster post-checkout: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
